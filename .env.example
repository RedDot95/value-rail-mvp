# Copy to .env and adjust. All paths are relative to the working directory unless absolute.
VALUE_RAIL_DB_PATH=./data/value_rail.db
VALUE_RAIL_CONFIG_PATH=./config/default.toml
VALUE_RAIL_FIXTURES_DIR=./tests/fixtures
VALUE_RAIL_MIGRATIONS_DIR=./migrations
VALUE_RAIL_LOG_LEVEL=INFO
# Simple HTTP Basic auth for the local prototype. Leave empty ONLY for localhost use.
# Exposing the UI beyond localhost requires TLS (reverse proxy) + these credentials.
VALUE_RAIL_BASIC_USER=
VALUE_RAIL_BASIC_PASSWORD=
